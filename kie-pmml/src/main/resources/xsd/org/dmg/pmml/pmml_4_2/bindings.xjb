<jxb:bindings xmlns:jxb="https://jakarta.ee/xml/ns/jaxb"
              xmlns:xs="http://www.w3.org/2001/XMLSchema"
              xmlns:xsd="http://www.w3.org/2001/XMLSchema"
              xmlns="http://java.sun.com/xml/ns/jaxb/xjc"
              jxb:version="3.0"
              jxb:extensionBindingPrefixes="xjc">

    <jxb:globalBindings choiceContentProperty="true" fixedAttributeAsConstantProperty="true">
     <simple />
     <jxb:serializable uid="145235" />

    </jxb:globalBindings>

    <jxb:bindings schemaLocation="./pmml-4-2.xsd" node="/xs:schema">

        <jxb:bindings node=".//xs:simpleType[@name='DELIMITER']">
                   <jxb:typesafeEnumClass name = "ENUM_DELIMITER"/>
        </jxb:bindings>
        <jxb:bindings node=".//xs:simpleType[@name='TIME-ANCHOR']">
                   <jxb:typesafeEnumClass name = "ENUM_TIMEANCHOR"/>
        </jxb:bindings>
        <jxb:bindings node=".//xs:element[@name='Con']">
                   <jxb:class name = "Synapse"/>
        </jxb:bindings>

    </jxb:bindings>

</jxb:bindings>
