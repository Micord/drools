			<xs:sequence>
				<xs:group ref="pmml:INT-ARRAY" minOccurs="1"/>
			</xs:sequence>
			<xs:attribute name="type" type="pmml:TIME-EXCEPTION-TYPE"/>
			<xs:attribute name="count" type="pmml:INT-NUMBER"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="TIME-EXCEPTION-TYPE">
		<xs:restriction base="xs:string">
			<xs:enumeration value="exclude"/>
			<xs:enumeration value="include"/>
		</xs:restriction>
