			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element maxOccurs="unbounded" ref="pmml:MiningField"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
