		<xs:restriction base="xs:string">
			<xs:enumeration value="includeAll"/>
			<xs:enumeration value="includeFromTo"/>
			<xs:enumeration value="excludeFromTo"/>
			<xs:enumeration value="includeSet"/>
			<xs:enumeration value="excludeSet"/>
		</xs:restriction>
	</xs:simpleType>
