					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="none"/>
						<xs:enumeration value="logarithmic"/>
						<xs:enumeration value="squareroot"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
