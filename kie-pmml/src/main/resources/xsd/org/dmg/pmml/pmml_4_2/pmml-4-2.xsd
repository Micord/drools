			<xs:attribute name="value" type="pmml:REAL-NUMBER" use="required"/>
			<xs:attribute name="standardError" type="pmml:REAL-NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TimeAnchor">
