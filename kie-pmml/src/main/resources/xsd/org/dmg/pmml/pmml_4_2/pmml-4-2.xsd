			</xs:sequence>
			<xs:attribute name="length" type="pmml:INT-NUMBER"/>
			<xs:attribute name="type" type="pmml:VALID-TIME-SPEC"/>
			<xs:attribute name="displayName" use="optional"/>
		</xs:complexType>
	</xs:element>
