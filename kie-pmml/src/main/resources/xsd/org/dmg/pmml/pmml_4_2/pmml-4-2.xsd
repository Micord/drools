		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:choice>
					<xs:element ref="pmml:PredictiveModelQuality" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="pmml:ClusteringModelQuality" minOccurs="0" maxOccurs="unbounded"/>
				</xs:choice>
				<xs:element ref="pmml:Correlations" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="PredictiveModelQuality">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ConfusionMatrix" minOccurs="0"/>
				<xs:element ref="pmml:LiftData" minOccurs="0"/>
				<xs:element ref="pmml:ROC" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="targetField" type="xs:string" use="required"/>
			<xs:attribute name="dataName" type="xs:string" use="optional"/>
			<xs:attribute name="dataUsage" default="training">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="training"/>
						<xs:enumeration value="test"/>
						<xs:enumeration value="validation"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="meanError" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="meanAbsoluteError" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="meanSquaredError" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="rootMeanSquaredError" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="r-squared" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="adj-r-squared" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="sumSquaredError" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="sumSquaredRegression" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="numOfRecords" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="numOfRecordsWeighted" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="numOfPredictors" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="degreesOfFreedom" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="fStatistic" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="AIC" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="BIC" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="AICc" type="pmml:NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ClusteringModelQuality">
		<xs:complexType>
			<xs:attribute name="dataName" type="xs:string" use="optional"/>
			<xs:attribute name="SSE" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="SSB" type="pmml:NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="LiftData">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ModelLiftGraph"/>
				<xs:element ref="pmml:OptimumLiftGraph" minOccurs="0"/>
				<xs:element ref="pmml:RandomLiftGraph" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="targetFieldValue" type="xs:string"/>
			<xs:attribute name="targetFieldDisplayValue" type="xs:string"/>
			<xs:attribute name="rankingQuality" type="pmml:NUMBER"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ModelLiftGraph">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:LiftGraph"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="OptimumLiftGraph">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:LiftGraph"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RandomLiftGraph">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:LiftGraph"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LiftGraph">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:XCoordinates"/>
				<xs:element ref="pmml:YCoordinates"/>
				<xs:element ref="pmml:BoundaryValues" minOccurs="0"/>
				<xs:element ref="pmml:BoundaryValueMeans" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="XCoordinates">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:NUM-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="YCoordinates">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:NUM-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BoundaryValues">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:NUM-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="BoundaryValueMeans">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:NUM-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ROC">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ROCGraph"/>
			</xs:sequence>
			<xs:attribute name="positiveTargetFieldValue" type="xs:string" use="required"/>
			<xs:attribute name="positiveTargetFieldDisplayValue" type="xs:string"/>
			<xs:attribute name="negativeTargetFieldValue" type="xs:string"/>
			<xs:attribute name="negativeTargetFieldDisplayValue" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ROCGraph">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:XCoordinates"/>
				<xs:element ref="pmml:YCoordinates"/>
				<xs:element ref="pmml:BoundaryValues" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ConfusionMatrix">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ClassLabels"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ClassLabels">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:STRING-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Correlations">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:CorrelationFields"/>
				<xs:element ref="pmml:CorrelationValues"/>
				<xs:element ref="pmml:CorrelationMethods" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CorrelationFields">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:STRING-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CorrelationValues">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CorrelationMethods">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TreeModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:Node"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="missingValueStrategy" type="pmml:MISSING-VALUE-STRATEGY" default="none"/>
			<xs:attribute name="missingValuePenalty" type="pmml:PROB-NUMBER" default="1.0"/>
			<xs:attribute name="noTrueChildStrategy" type="pmml:NO-TRUE-CHILD-STRATEGY" default="returnNullPrediction"/>
			<xs:attribute name="splitCharacteristic" default="multiSplit">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="binarySplit"/>
						<xs:enumeration value="multiSplit"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Node">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:PREDICATE"/>
				<xs:choice>
					<xs:sequence>
						<xs:element ref="pmml:Partition" minOccurs="0"/>
						<xs:element ref="pmml:ScoreDistribution" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element ref="pmml:Node" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:group ref="pmml:EmbeddedModel"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string"/>
			<xs:attribute name="score" type="xs:string"/>
			<xs:attribute name="recordCount" type="pmml:NUMBER"/>
			<xs:attribute name="defaultChild" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:group name="PREDICATE">
		<xs:choice>
			<xs:element ref="pmml:SimplePredicate"/>
			<xs:element ref="pmml:CompoundPredicate"/>
			<xs:element ref="pmml:SimpleSetPredicate"/>
			<xs:element ref="pmml:True"/>
			<xs:element ref="pmml:False"/>
		</xs:choice>
	</xs:group>
	<xs:element name="SimplePredicate">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="field" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="operator" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="equal"/>
						<xs:enumeration value="notEqual"/>
						<xs:enumeration value="lessThan"/>
						<xs:enumeration value="lessOrEqual"/>
						<xs:enumeration value="greaterThan"/>
						<xs:enumeration value="greaterOrEqual"/>
						<xs:enumeration value="isMissing"/>
						<xs:enumeration value="isNotMissing"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="value" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CompoundPredicate">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:sequence minOccurs="2" maxOccurs="unbounded">
					<xs:group ref="pmml:PREDICATE"/>
				</xs:sequence>
			</xs:sequence>
			<xs:attribute name="booleanOperator" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="or"/>
						<xs:enumeration value="and"/>
						<xs:enumeration value="xor"/>
						<xs:enumeration value="surrogate"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="SimpleSetPredicate">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Array"/>
			</xs:sequence>
			<xs:attribute name="field" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="booleanOperator" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="isIn"/>
						<xs:enumeration value="isNotIn"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="True">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="False">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ScoreDistribution">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="value" type="xs:string" use="required"/>
			<xs:attribute name="recordCount" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="confidence" type="pmml:PROB-NUMBER"/>
			<xs:attribute name="probability" type="pmml:PROB-NUMBER"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="MISSING-VALUE-STRATEGY">
		<xs:restriction base="xs:string">
			<xs:enumeration value="lastPrediction"/>
			<xs:enumeration value="nullPrediction"/>
			<xs:enumeration value="defaultChild"/>
			<xs:enumeration value="weightedConfidence"/>
			<xs:enumeration value="aggregateNodes"/>
			<xs:enumeration value="none"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NO-TRUE-CHILD-STRATEGY">
		<xs:restriction base="xs:string">
			<xs:enumeration value="returnNullPrediction"/>
			<xs:enumeration value="returnLastPrediction"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
