<xs:schema version="1.0"
					 targetNamespace="http://www.dmg.org/PMML-4_2"
					 xmlns:pmml="http://www.dmg.org/PMML-4_2"
					 xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="DefineFunction">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ParameterField" minOccurs="1" maxOccurs="unbounded"/>
				<xs:group ref="pmml:EXPRESSION"/>
			</xs:sequence>
			<xs:attribute name="name" type="xs:string" use="required"/>
			<xs:attribute name="optype" type="pmml:OPTYPE" use="required"/>
			<xs:attribute name="dataType" type="pmml:DATATYPE"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ParameterField">
		<xs:complexType>
			<xs:attribute name="name" type="xs:string" use="required"/>
			<xs:attribute name="optype" type="pmml:OPTYPE"/>
			<xs:attribute name="dataType" type="pmml:DATATYPE"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Apply">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:EXPRESSION" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="function" type="xs:string" use="required"/>
			<xs:attribute name="mapMissingTo" type="xs:string"/>
			<xs:attribute name="defaultValue" type="xs:string"/>
			<xs:attribute name="invalidValueTreatment" type="pmml:INVALID-VALUE-TREATMENT-METHOD" default="returnInvalid"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MiningModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element ref="pmml:Regression"/>
					<xs:element ref="pmml:DecisionTree"/>
				</xs:choice>
				<xs:element ref="pmml:Segmentation" minOccurs="0"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string" use="optional"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string" use="optional"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Segmentation">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Segment" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="multipleModelMethod" type="pmml:MULTIPLE-MODEL-METHOD" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Segment">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:PREDICATE"/>
				<xs:group ref="pmml:MODEL-ELEMENT"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="optional"/>
			<xs:attribute name="weight" type="pmml:NUMBER" use="optional" default="1"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="MULTIPLE-MODEL-METHOD">
		<xs:restriction base="xs:string">
			<xs:enumeration value="majorityVote"/>
			<xs:enumeration value="weightedMajorityVote"/>
			<xs:enumeration value="average"/>
			<xs:enumeration value="weightedAverage"/>
			<xs:enumeration value="median"/>
			<xs:enumeration value="max"/>
			<xs:enumeration value="sum"/>
			<xs:enumeration value="selectFirst"/>
			<xs:enumeration value="selectAll"/>
			<xs:enumeration value="modelChain"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:group name="EmbeddedModel">
		<xs:sequence>
			<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			<xs:choice>
				<xs:element ref="pmml:Regression"/>
				<xs:element ref="pmml:DecisionTree"/>
			</xs:choice>
		</xs:sequence>
	</xs:group>
	<xs:element name="ResultField">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="name" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="displayName" type="xs:string"/>
			<xs:attribute name="optype" type="pmml:OPTYPE"/>
			<xs:attribute name="dataType" type="pmml:DATATYPE"/>
			<xs:attribute name="feature" type="pmml:RESULT-FEATURE"/>
			<xs:attribute name="value" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Regression">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:ResultField" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:RegressionTable" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="normalizationMethod" type="pmml:REGRESSIONNORMALIZATIONMETHOD" default="none"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="DecisionTree">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:ResultField" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Node"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="missingValueStrategy" type="pmml:MISSING-VALUE-STRATEGY" default="none"/>
			<xs:attribute name="missingValuePenalty" type="pmml:PROB-NUMBER" default="1.0"/>
			<xs:attribute name="noTrueChildStrategy" type="pmml:NO-TRUE-CHILD-STRATEGY" default="returnNullPrediction"/>
			<xs:attribute name="splitCharacteristic" default="multiSplit">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="binarySplit"/>
						<xs:enumeration value="multiSplit"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="AssociationModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:Item" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Itemset" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:AssociationRule" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="numberOfTransactions" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="maxNumberOfItemsPerTA" type="pmml:INT-NUMBER"/>
			<xs:attribute name="avgNumberOfItemsPerTA" type="pmml:REAL-NUMBER"/>
			<xs:attribute name="minimumSupport" type="pmml:PROB-NUMBER" use="required"/>
			<xs:attribute name="minimumConfidence" type="pmml:PROB-NUMBER" use="required"/>
			<xs:attribute name="lengthLimit" type="pmml:INT-NUMBER"/>
			<xs:attribute name="numberOfItems" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="numberOfItemsets" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="numberOfRules" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Item">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required"/>
			<xs:attribute name="value" type="xs:string" use="required"/>
			<xs:attribute name="mappedValue" type="xs:string"/>
			<xs:attribute name="weight" type="pmml:REAL-NUMBER"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Itemset">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element minOccurs="0" maxOccurs="unbounded" ref="pmml:ItemRef"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required"/>
			<xs:attribute name="support" type="pmml:PROB-NUMBER"/>
			<xs:attribute name="numberOfItems" type="xs:nonNegativeInteger"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ItemRef">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="itemRef" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="AssociationRule">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="antecedent" type="xs:string" use="required"/>
			<xs:attribute name="consequent" type="xs:string" use="required"/>
			<xs:attribute name="support" type="pmml:PROB-NUMBER" use="required"/>
			<xs:attribute name="confidence" type="pmml:PROB-NUMBER" use="required"/>
			<xs:attribute name="lift" type="xs:float" use="optional"/>
			<xs:attribute name="leverage" type="xs:float" use="optional"/>
			<xs:attribute name="affinity" type="pmml:PROB-NUMBER" use="optional"/>
			<xs:attribute name="id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RuleSetModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:RuleSet"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string" use="optional"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string" use="optional"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RuleSet">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:RuleSelectionMethod" minOccurs="1" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ScoreDistribution" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:Rule" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="recordCount" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="nbCorrect" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="defaultScore" type="xs:string" use="optional"/>
			<xs:attribute name="defaultConfidence" type="pmml:NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RuleSelectionMethod">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="criterion" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="weightedSum"/>
						<xs:enumeration value="weightedMax"/>
						<xs:enumeration value="firstHit"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:group name="Rule">
		<xs:choice>
			<xs:element ref="pmml:SimpleRule"/>
			<xs:element ref="pmml:CompoundRule"/>
		</xs:choice>
	</xs:group>
	<xs:element name="SimpleRule">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:PREDICATE"/>
				<xs:element ref="pmml:ScoreDistribution" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="optional"/>
			<xs:attribute name="score" type="xs:string" use="required"/>
			<xs:attribute name="recordCount" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="nbCorrect" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="confidence" type="pmml:NUMBER" use="optional" default="1"/>
			<xs:attribute name="weight" type="pmml:NUMBER" use="optional" default="1"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CompoundRule">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:PREDICATE"/>
				<xs:group ref="pmml:Rule" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ClusteringModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:ComparisonMeasure"/>
				<xs:element ref="pmml:ClusteringField" minOccurs="1" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MissingValueWeights" minOccurs="0"/>
				<xs:element ref="pmml:Cluster" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string" use="optional"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string" use="optional"/>
			<xs:attribute name="modelClass" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="centerBased"/>
						<xs:enumeration value="distributionBased"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="numberOfClusters" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MissingValueWeights">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:group ref="pmml:NUM-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Cluster">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:KohonenMap" minOccurs="0"/>
				<xs:group ref="pmml:NUM-ARRAY" minOccurs="0"/>
				<xs:element ref="pmml:Partition" minOccurs="0"/>
				<xs:element ref="pmml:Covariances" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="optional"/>
			<xs:attribute name="name" type="xs:string" use="optional"/>
			<xs:attribute name="size" type="xs:nonNegativeInteger" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="KohonenMap">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="coord1" type="xs:float" use="optional"/>
			<xs:attribute name="coord2" type="xs:float" use="optional"/>
			<xs:attribute name="coord3" type="xs:float" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Covariances">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ClusteringField">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Comparisons" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="field" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="isCenterField" default="true">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="true"/>
						<xs:enumeration value="false"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="fieldWeight" type="pmml:REAL-NUMBER" default="1"/>
			<xs:attribute name="similarityScale" type="pmml:REAL-NUMBER" use="optional"/>
			<xs:attribute name="compareFunction" type="pmml:COMPARE-FUNCTION" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Comparisons">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="COMPARE-FUNCTION">
		<xs:restriction base="xs:string">
			<xs:enumeration value="absDiff"/>
			<xs:enumeration value="gaussSim"/>
			<xs:enumeration value="delta"/>
			<xs:enumeration value="equal"/>
			<xs:enumeration value="table"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="ComparisonMeasure">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:choice>
					<xs:element ref="pmml:euclidean"/>
					<xs:element ref="pmml:squaredEuclidean"/>
					<xs:element ref="pmml:chebychev"/>
					<xs:element ref="pmml:cityBlock"/>
					<xs:element ref="pmml:minkowski"/>
					<xs:element ref="pmml:simpleMatching"/>
					<xs:element ref="pmml:jaccard"/>
					<xs:element ref="pmml:tanimoto"/>
					<xs:element ref="pmml:binarySimilarity"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="kind" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="distance"/>
						<xs:enumeration value="similarity"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="compareFunction" type="pmml:COMPARE-FUNCTION" default="absDiff"/>
			<xs:attribute name="minimum" type="pmml:NUMBER" use="optional"/>
			<xs:attribute name="maximum" type="pmml:NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="euclidean">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="squaredEuclidean">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="cityBlock">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="chebychev">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="minkowski">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="p-parameter" type="pmml:NUMBER" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="simpleMatching">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="jaccard">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tanimoto">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="binarySimilarity">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="c00-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="c01-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="c10-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="c11-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="d00-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="d01-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="d10-parameter" type="pmml:NUMBER" use="required"/>
			<xs:attribute name="d11-parameter" type="pmml:NUMBER" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RegressionModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:RegressionTable" maxOccurs="unbounded"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="modelType" use="optional">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="linearRegression"/>
						<xs:enumeration value="stepwisePolynomialRegression"/>
						<xs:enumeration value="logisticRegression"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="targetFieldName" type="pmml:FIELD-NAME" use="optional"/>
			<xs:attribute name="normalizationMethod" type="pmml:REGRESSIONNORMALIZATIONMETHOD" default="none"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="REGRESSIONNORMALIZATIONMETHOD">
		<xs:restriction base="xs:string">
			<xs:enumeration value="none"/>
			<xs:enumeration value="simplemax"/>
			<xs:enumeration value="softmax"/>
			<xs:enumeration value="logit"/>
			<xs:enumeration value="probit"/>
			<xs:enumeration value="cloglog"/>
			<xs:enumeration value="exp"/>
			<xs:enumeration value="loglog"/>
			<xs:enumeration value="cauchit"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="RegressionTable">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:NumericPredictor" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:CategoricalPredictor" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:PredictorTerm" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="intercept" type="pmml:REAL-NUMBER" use="required"/>
			<xs:attribute name="targetCategory" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="NumericPredictor">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="name" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="exponent" type="pmml:INT-NUMBER" default="1"/>
			<xs:attribute name="coefficient" type="pmml:REAL-NUMBER" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CategoricalPredictor">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="name" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="value" type="xs:string" use="required"/>
			<xs:attribute name="coefficient" type="pmml:REAL-NUMBER" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="PredictorTerm">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:FieldRef" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="name" type="pmml:FIELD-NAME"/>
			<xs:attribute name="coefficient" type="pmml:REAL-NUMBER" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:TextDictionary"/>
				<xs:element ref="pmml:TextCorpus"/>
				<xs:element ref="pmml:DocumentTermMatrix"/>
				<xs:element ref="pmml:TextModelNormalization" minOccurs="0"/>
				<xs:element ref="pmml:TextModelSimiliarity" minOccurs="0"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="numberOfTerms" type="xs:integer" use="required"/>
			<xs:attribute name="numberOfDocuments" type="xs:integer" use="required"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextDictionary">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Taxonomy" minOccurs="0"/>
				<xs:group ref="pmml:STRING-ARRAY"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextCorpus">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:TextDocument" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextDocument">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="id" type="xs:string" use="required"/>
			<xs:attribute name="name" type="xs:string" use="optional"/>
			<xs:attribute name="length" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="file" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="DocumentTermMatrix">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Matrix"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextModelNormalization">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="localTermWeights" default="termFrequency">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="termFrequency"/>
						<xs:enumeration value="binary"/>
						<xs:enumeration value="logarithmic"/>
						<xs:enumeration value="augmentedNormalizedTermFrequency"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="globalTermWeights" default="inverseDocumentFrequency">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="inverseDocumentFrequency"/>
						<xs:enumeration value="none"/>
						<xs:enumeration value="GFIDF"/>
						<xs:enumeration value="normal"/>
						<xs:enumeration value="probabilisticInverse"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="documentNormalization" default="none">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="none"/>
						<xs:enumeration value="cosine"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="TextModelSimiliarity">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="similarityType">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="euclidean"/>
						<xs:enumeration value="cosine"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="NearestNeighborModel">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MiningSchema"/>
				<xs:element ref="pmml:Output" minOccurs="0"/>
				<xs:element ref="pmml:ModelStats" minOccurs="0"/>
				<xs:element ref="pmml:ModelExplanation" minOccurs="0"/>
				<xs:element ref="pmml:Targets" minOccurs="0"/>
				<xs:element ref="pmml:LocalTransformations" minOccurs="0"/>
				<xs:element ref="pmml:TrainingInstances"/>
				<xs:element ref="pmml:ComparisonMeasure"/>
				<xs:element ref="pmml:KNNInputs"/>
				<xs:element ref="pmml:ModelVerification" minOccurs="0"/>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="modelName" type="xs:string"/>
			<xs:attribute name="functionName" type="pmml:MINING-FUNCTION" use="required"/>
			<xs:attribute name="algorithmName" type="xs:string"/>
			<xs:attribute name="numberOfNeighbors" type="pmml:INT-NUMBER" use="required"/>
			<xs:attribute name="continuousScoringMethod" type="pmml:CONT-SCORING-METHOD" default="average"/>
			<xs:attribute name="categoricalScoringMethod" type="pmml:CAT-SCORING-METHOD" default="majorityVote"/>
			<xs:attribute name="instanceIdVariable" type="xs:string"/>
			<xs:attribute name="threshold" type="pmml:REAL-NUMBER" default="0.001"/>
			<xs:attribute name="isScorable" type="xs:boolean" default="true"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TrainingInstances">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:InstanceFields"/>
				<xs:choice>
					<xs:element ref="pmml:TableLocator"/>
					<xs:element ref="pmml:InlineTable"/>
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="isTransformed" type="xs:boolean" default="false"/>
			<xs:attribute name="recordCount" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="fieldCount" type="pmml:INT-NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="InstanceFields">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:InstanceField" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="InstanceField">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="field" type="xs:string" use="required"/>
			<xs:attribute name="column" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="KNNInputs">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:KNNInput" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="KNNInput">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="field" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="fieldWeight" type="pmml:REAL-NUMBER" default="1"/>
			<xs:attribute name="compareFunction" type="pmml:COMPARE-FUNCTION"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="CONT-SCORING-METHOD">
		<xs:restriction base="xs:string">
			<xs:enumeration value="median"/>
			<xs:enumeration value="average"/>
			<xs:enumeration value="weightedAverage"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CAT-SCORING-METHOD">
		<xs:restriction base="xs:string">
			<xs:enumeration value="majorityVote"/>
			<xs:enumeration value="weightedMajorityVote"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Targets">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Target" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Target">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:TargetValue" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="field" type="pmml:FIELD-NAME" use="required"/>
			<xs:attribute name="optype" type="pmml:OPTYPE"/>
			<xs:attribute name="castInteger">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="round"/>
						<xs:enumeration value="ceiling"/>
						<xs:enumeration value="floor"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="min" type="xs:double"/>
			<xs:attribute name="max" type="xs:double"/>
			<xs:attribute name="rescaleConstant" type="xs:double" default="0"/>
			<xs:attribute name="rescaleFactor" type="xs:double" default="1"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TargetValue">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="pmml:Partition" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="value" type="xs:string"/>
			<xs:attribute name="displayValue" type="xs:string"/>
			<xs:attribute name="priorProbability" type="pmml:PROB-NUMBER"/>
			<xs:attribute name="defaultValue" type="pmml:NUMBER"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="PMML">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Header"/>
				<xs:element ref="pmml:MiningBuildTask" minOccurs="0"/>
				<xs:element ref="pmml:DataDictionary"/>
				<xs:element ref="pmml:TransformationDictionary" minOccurs="0"/>
				<xs:sequence minOccurs="0" maxOccurs="unbounded">
					<xs:group ref="pmml:MODEL-ELEMENT"/>
				</xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="version" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:group name="MODEL-ELEMENT">
		<xs:choice>
			<xs:element ref="pmml:AssociationModel"/>
			<xs:element ref="pmml:BaselineModel"/>
			<xs:element ref="pmml:ClusteringModel"/>
			<xs:element ref="pmml:GeneralRegressionModel"/>
			<xs:element ref="pmml:MiningModel"/>
			<xs:element ref="pmml:NaiveBayesModel"/>
			<xs:element ref="pmml:NearestNeighborModel"/>
			<xs:element ref="pmml:NeuralNetwork"/>
			<xs:element ref="pmml:RegressionModel"/>
			<xs:element ref="pmml:RuleSetModel"/>
			<xs:element ref="pmml:SequenceModel"/>
			<xs:element ref="pmml:Scorecard"/>
			<xs:element ref="pmml:SupportVectorMachineModel"/>
			<xs:element ref="pmml:TextModel"/>
			<xs:element ref="pmml:TimeSeriesModel"/>
			<xs:element ref="pmml:TreeModel"/>
		</xs:choice>
	</xs:group>
	<xs:element name="MiningBuildTask">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Extension" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="MINING-FUNCTION">
		<xs:restriction base="xs:string">
			<xs:enumeration value="associationRules"/>
			<xs:enumeration value="sequences"/>
			<xs:enumeration value="classification"/>
			<xs:enumeration value="regression"/>
			<xs:enumeration value="clustering"/>
			<xs:enumeration value="timeSeries"/>
			<xs:enumeration value="mixed"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Extension">
		<xs:complexType>
			<xs:complexContent mixed="true">
				<xs:restriction base="xs:anyType">
					<xs:sequence>
						<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attribute name="extender" type="xs:string" use="optional"/>
					<xs:attribute name="name" type="xs:string" use="optional"/>
					<xs:attribute name="value" type="xs:string" use="optional"/>
				</xs:restriction>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="NUMBER">
		<xs:restriction base="xs:double"/>
	</xs:simpleType>
	<xs:simpleType name="INT-NUMBER">
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>
	<xs:simpleType name="REAL-NUMBER">
		<xs:restriction base="xs:double"/>
	</xs:simpleType>
	<xs:simpleType name="PROB-NUMBER">
		<xs:restriction base="xs:decimal"/>
	</xs:simpleType>
	<xs:simpleType name="PERCENTAGE-NUMBER">
		<xs:restriction base="xs:decimal"/>
	</xs:simpleType>
	<xs:simpleType name="FIELD-NAME">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:complexType name="ArrayType" mixed="true">
		<xs:attribute name="n" type="pmml:INT-NUMBER" use="optional"/>
		<xs:attribute name="type" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="int"/>
					<xs:enumeration value="real"/>
					<xs:enumeration value="string"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="Array" type="pmml:ArrayType"/>
	<xs:group name="NUM-ARRAY">
		<xs:choice>
			<xs:element ref="pmml:Array"/>
		</xs:choice>
	</xs:group>
	<xs:group name="INT-ARRAY">
		<xs:choice>
			<xs:element ref="pmml:Array"/>
		</xs:choice>
	</xs:group>
	<xs:group name="REAL-ARRAY">
		<xs:choice>
			<xs:element ref="pmml:Array"/>
		</xs:choice>
	</xs:group>
	<xs:group name="STRING-ARRAY">
		<xs:choice>
			<xs:element ref="pmml:Array"/>
		</xs:choice>
	</xs:group>
	<xs:element name="INT-SparseArray">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Indices" minOccurs="0"/>
				<xs:element ref="pmml:INT-Entries" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="n" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="defaultValue" type="pmml:INT-NUMBER" use="optional" default="0"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="REAL-SparseArray">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Indices" minOccurs="0"/>
				<xs:element ref="pmml:REAL-Entries" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="n" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="defaultValue" type="pmml:REAL-NUMBER" use="optional" default="0"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Indices">
		<xs:simpleType>
			<xs:list itemType="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="INT-Entries">
		<xs:simpleType>
			<xs:list itemType="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="REAL-Entries">
		<xs:simpleType>
			<xs:list itemType="xs:double"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Matrix">
		<xs:complexType>
			<xs:choice minOccurs="0">
				<xs:group ref="pmml:NUM-ARRAY" maxOccurs="unbounded"/>
				<xs:element ref="pmml:MatCell" maxOccurs="unbounded"/>
			</xs:choice>
			<xs:attribute name="kind" use="optional" default="any">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="diagonal"/>
						<xs:enumeration value="symmetric"/>
						<xs:enumeration value="any"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="nbRows" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="nbCols" type="pmml:INT-NUMBER" use="optional"/>
			<xs:attribute name="diagDefault" type="pmml:REAL-NUMBER" use="optional"/>
			<xs:attribute name="offDiagDefault" type="pmml:REAL-NUMBER" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MatCell">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="row" type="pmml:INT-NUMBER" use="required"/>
					<xs:attribute name="col" type="pmml:INT-NUMBER" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
