		<xs:complexType>
			<xs:sequence>
				<xs:element ref="pmml:Level" minOccurs="1" maxOccurs="1"/>
				<xs:element ref="pmml:Trend_ExpoSmooth" minOccurs="0" maxOccurs="1"/>
				<xs:element ref="pmml:Seasonality_ExpoSmooth" minOccurs="0" maxOccurs="1"/>
