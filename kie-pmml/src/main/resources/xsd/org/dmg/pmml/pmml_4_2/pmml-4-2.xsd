			<xs:enumeration value="dateTimeSecondsSince[0]"/>
			<xs:enumeration value="dateTimeSecondsSince[1960]"/>
			<xs:enumeration value="dateTimeSecondsSince[1970]"/>
			<xs:enumeration value="dateTimeSecondsSince[1980]"/>
